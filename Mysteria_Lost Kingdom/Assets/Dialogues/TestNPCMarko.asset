  - npcName: "\u041C\u0430\u0440\u043A\u043E"
    text: "\u042F\u043A\u0449\u043E \u0442\u043E\u0431\u0456 \u043D\u0435 \u0442\u044F\u0436\u043A\u043E,
      \u0442\u0443\u0442 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0456\u043A \u0454
      \u044F\u0449\u0438\u043A \u0456\u0437 \u0440\u0435\u0447\u0430\u043C\u0438,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u0435\u043D\u0456 \u0443\u0441\u044E
      \u0446\u0438\u0431\u0443\u043B\u044E"
    options:
    - playerResponse: "\u0414\u043E\u0431\u0440\u0435, \u044F \u0437\u0430\u0439\u043C\u0443\u0441\u044F
        \u0446\u0438\u043C"
      nextLineID: 4
      endsThisLinePermanently: 1
      hasFinalResponse: 1
      finalNpcResponse: "\u0414\u044F\u043A\u0443\u044E, \u0431\u0443\u0434\u0443
