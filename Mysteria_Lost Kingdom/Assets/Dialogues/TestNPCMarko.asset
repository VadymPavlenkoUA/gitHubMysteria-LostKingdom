  m_Script: {fileID: 11500000, guid: 9e7f35c4b9676974b9a16c44bae8f9d6, type: 3}
  m_Name: TestNPCMarko
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: "\u041C\u0430\u0440\u043A\u043E"
  npcIcon: {fileID: 21300000, guid: 02d3af3973d47124d995cab4f81f4575, type: 3}
  lines:
  - npcName: "\u041C\u0430\u0440\u043A\u043E"
    text: "\u041F\u0440\u0438\u0432\u0456\u0442, \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A\u0443.
      \u0422\u0438 \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0431\u0443\u0432
      \u0443 \u0446\u0438\u0445 \u0437\u0435\u043C\u043B\u044F\u0445.\r\n\u041A\u043E\u043B\u0438\u0441\u044C
      \u0442\u0443\u0442 \u043A\u0438\u043F\u0456\u043B\u043E \u0436\u0438\u0442\u0442\u044F,
      \u0430\u043B\u0435 \u0442\u0435\u043F\u0435\u0440 - \u043B\u0438\u0448\u0435
      \u0442\u0456\u043D\u0456 \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E.\n\u0427\u043E\u0433\u043E
      \u0448\u0443\u043A\u0430\u0454\u0448 \u0443 \u0446\u0438\u0445 \u0440\u0443\u0457\u043D\u0430\u0445?"
    options:
    - playerResponse: "\u041F\u0440\u0438\u0432\u0456\u0442, \u044F \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A,
        \u044F\u043A\u0438\u0439 \u043D\u0435\u0449\u043E\u0434\u0430\u0432\u043D\u043E
        \u043F\u0440\u0438\u0431\u0443\u0432 \u0443 \u0446\u0456 \u0437\u0435\u043C\u043B\u0456"
      nextLineID: 1
    - playerResponse: "\u0411\u0443\u0432\u0430\u0439"
      nextLineID: -1
  - npcName: "\u041C\u0430\u0440\u043A\u043E"
    text: "\u041F\u0440\u0438\u0454\u043C\u043D\u043E \u0447\u0443\u0442\u0438, \u0449\u043E
      \u0434\u043E\u0441\u0456 \u0456\u0441\u043D\u0443\u044E\u0442\u044C \u0441\u043C\u0456\u043B\u0438\u0432\u0446\u0456,
      \u044F\u043A\u0456 \u0433\u043E\u0442\u043E\u0432\u0456 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438\u0441\u044F
      \u0443 \u0446\u0456 \u0437\u0435\u043C\u043B\u0456!"
    options: []
